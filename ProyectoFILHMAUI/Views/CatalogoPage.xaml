<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProyectoFILHMAUI.Views.CatalogoPage"
             Title="Catálogo">

    <Grid RowDefinitions="Auto,*">

        <ActivityIndicator Grid.Row="0"
                            IsRunning="{Binding Cargando}"
                            IsVisible="{Binding Cargando}"
                            HorizontalOptions="Center"
                            Margin="0,10" />

        <CollectionView Grid.Row="1"
                         ItemsSource="{Binding Productos}"
                         ItemsLayout="VerticalGrid, 2">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="8" Padding="10" StrokeShape="RoundRectangle 8">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding Nombre}" FontAttributes="Bold" FontSize="16" />
                            <Label Text="{Binding Categoria.Nombre}" FontSize="12" TextColor="Gray" />
                            <Label Text="{Binding Precio, StringFormat='${0:N2}'}" FontSize="14" />
                            <Label Text="{Binding CantDisponible, StringFormat='Disponibles: {0}'}" FontSize="11" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>